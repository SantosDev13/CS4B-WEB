# ============================================
# Database - PostgreSQL
# ============================================
# Reemplaza con los valores de tu Supabase dashboard:
# Settings > Connection Pooling > Connection string
DATABASE_URL=postgresql://postgres:tu_password@db.tu-project-id.supabase.co:5432/postgres

# ============================================
# Supabase Client
# ============================================
# Obtén estos valores de: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# ============================================
# Authentication - JWT
# ============================================
# Genera un secret con: openssl rand -hex 32
JWT_SECRET=tu_jwt_secret_aqui

# ============================================
# Next.js Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Environment
# ============================================
NODE_ENV=development